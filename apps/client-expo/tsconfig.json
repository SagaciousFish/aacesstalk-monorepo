{
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ],
      "apps/client-rn/src/*": [
        "../client-rn/src/*"
      ],
      "@aacesstalk/libs/ts-core/*": [
        "../../libs/ts-core/src/*"
      ]
    },
    "strict": true
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}